# AWS Region where resources are deployed
VITE_AWS_REGION=us-east-1

# Amazon Cognito Configuration (Phase 1)
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Amazon API Gateway Endpoint (Phase 3)
VITE_API_GATEWAY_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod

# Amazon S3 / CloudFront Configuration (Phase 4 & 5)
VITE_S3_BUCKET=robo-lms-certificates-demo
VITE_CLOUDFRONT_DOMAIN=https://dxxxxxxxxxxxxx.cloudfront.net

